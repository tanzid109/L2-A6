{
  "info": {
    "name": "FieldOps System Backend",
    "_postman_id": "fieldops-api-collection",
    "description": "API Collection for FieldOps System Backend - Auth & Service modules",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password1!\",\n  \"phone\": \"+8801712345678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/verify-email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "verify-email"]
            }
          },
          "response": []
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password1!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Login and save tokens to variables"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data) {",
                  "    if (jsonData.data.accessToken) {",
                  "        pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
                  "    }",
                  "    if (jsonData.data.refreshToken) {",
                  "        pm.collectionVariables.set('refreshToken', jsonData.data.refreshToken);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"google-id-token-from-client\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/google-login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "google-login"]
            }
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh-token",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh-token"]
            }
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            }
          },
          "response": []
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPassword1!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "reset-password"]
            }
          },
          "response": []
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Requires Bearer token"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Services",
      "item": [
        {
          "name": "Get All Services",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/services?search=&category=&isActive=&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services"],
              "query": [
                {
                  "key": "search",
                  "value": "",
                  "description": "Search in title and description"
                },
                {
                  "key": "category",
                  "value": "",
                  "description": "Filter by category"
                },
                {
                  "key": "isActive",
                  "value": "",
                  "description": "Filter by active status (true/false)"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page (max 100)"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Service By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/services/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "service-uuid-here"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Service",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "AC Repair Service",
                  "type": "text"
                },
                {
                  "key": "slug",
                  "value": "ac-repair-service",
                  "type": "text"
                },
                {
                  "key": "description",
                  "value": "Professional AC repair and maintenance service for residential and commercial properties",
                  "type": "text"
                },
                {
                  "key": "category",
                  "value": "HVAC",
                  "type": "text"
                },
                {
                  "key": "price",
                  "value": "1500",
                  "type": "text"
                },
                {
                  "key": "duration",
                  "value": "120",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": null
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/services",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services"]
            },
            "description": "Requires ADMIN role. Send as multipart/form-data. Image is optional."
          },
          "response": []
        },
        {
          "name": "Update Service",
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "title",
                  "value": "AC Repair Service - Premium",
                  "type": "text"
                },
                {
                  "key": "price",
                  "value": "2500",
                  "type": "text"
                },
                {
                  "key": "isActive",
                  "value": "true",
                  "type": "text"
                },
                {
                  "key": "image",
                  "type": "file",
                  "src": null
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/services/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "service-uuid-here"
                }
              ]
            },
            "description": "Requires ADMIN role. Send as multipart/form-data. All fields are optional, including image."
          },
          "response": []
        },
        {
          "name": "Delete Service",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/services/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "services", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "service-uuid-here"
                }
              ]
            },
            "description": "Requires ADMIN role. Soft delete - sets isActive to false"
          },
          "response": []
        }
      ]
    }
  ]
}
