<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Application Rejected</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
      background: #0f172a;
      color: #e2e8f0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
    }

    .wrapper {
      width: 100%;
      max-width: 520px;
    }

    .container {
      background: #1e293b;
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 25px 50px rgba(0, 0, 0, 0.4);
    }

    .header {
      background: linear-gradient(135deg, #ef4444, #b91c1c);
      padding: 40px 32px;
      text-align: center;
    }

    .logo {
      font-size: 28px;
      font-weight: 800;
      color: #fff;
      letter-spacing: -0.5px;
    }

    .logo span {
      color: #fecaca;
      font-weight: 400;
    }

    .header-icon {
      width: 64px;
      height: 64px;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 16px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 16px;
      font-size: 32px;
    }

    .body {
      padding: 36px 32px;
    }

    .greeting {
      font-size: 22px;
      font-weight: 700;
      color: #f8fafc;
      margin-bottom: 12px;
    }

    .message {
      font-size: 15px;
      line-height: 1.7;
      color: #94a3b8;
      margin-bottom: 24px;
    }

    .reason-wrap {
      background: #0f172a;
      border: 1px solid #7f1d1d;
      border-left: 3px solid #ef4444;
      border-radius: 12px;
      padding: 20px;
      margin-bottom: 24px;
    }

    .reason-label {
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      color: #f87171;
      margin-bottom: 8px;
    }

    .reason-text {
      font-size: 15px;
      line-height: 1.6;
      color: #fecaca;
    }

    .note {
      font-size: 13px;
      color: #64748b;
      line-height: 1.6;
    }

    .divider {
      height: 1px;
      background: #334155;
      margin: 0 32px;
    }

    .footer {
      padding: 24px 32px;
      text-align: center;
      font-size: 12px;
      color: #475569;
    }
  </style>
</head>

<body>
  <div class="wrapper">
    <div class="container">
      <div class="header">
        <div class="header-icon">&times;</div>
        <div class="logo">Field<span>Ops</span></div>
      </div>
      <div class="body">
        <div class="greeting">Application not approved</div>
        <p class="message">
          Hello <%= name %>, thank you for applying to join FieldOps as a technician.
          After review, we are unable to approve your application at this time.
        </p>
        <div class="reason-wrap">
          <div class="reason-label">Reason</div>
          <div class="reason-text">
            <%= reason %>
          </div>
        </div>
        <p class="note">
          Your account is unchanged and you can continue to use FieldOps as a customer.
          You are welcome to apply again once the above has been addressed.
        </p>
      </div>
      <div class="divider"></div>
      <div class="footer">
        &copy; 2026 FieldOps. All rights reserved.
      </div>
    </div>
  </div>
</body>

</html>